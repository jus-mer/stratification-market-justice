  langid = {english},
  file = {/home/juank/Dropbox/zoterojcydocs/storage/XBGKYUUH/Busemeyer et al. - 2009 - Attitudes towards redistributive spending in an era of demographic ageing the rival pressures from.pdf}
}

@article{busemeyer_conflictive_2017,
