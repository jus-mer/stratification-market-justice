  shorttitle = {Conflictive Preferences towards Social Investments and Transfers in Mature Welfare States},
  author = {Busemeyer, Marius R. and Neimanns, Erik},
  year = 2017,
  month = jul,
  journal = {Journal of European Social Policy},
  volume = {27},
  number = {3},
  pages = {229--246},
  issn = {0958-9287, 1461-7269},
  doi = {10.1177/0958928716684302},
  urldate = {2025-11-14},
  abstract = {This article explores potential cleavages and conflicts between political support coalitions of social investment versus classical social transfer policies. To that extent, we analyse international survey data from the European Social Survey (ESS) for 21 European countries. Our central finding is that different welfare state beneficiary groups perceive and react negatively to increased government involvement in policy fields from which they do not benefit themselves: single parents are more likely to oppose government support for the unemployed when long-term replacement rates in the unemployment benefit scheme are high. Vice versa, the unemployed are less likely to support the public provision of childcare services if the latter is already well-funded. This finding has implications for the study of welfare states in general because it implies that in mature welfare states, political conflicts may be less about the welfare state as such, but about the distribution of welfare state services and benefits between different groups of beneficiaries.},
  langid = {english},
  file = {/Users/macbookair/Zotero/storage/UWVNKXS6/Busemeyer y Neimanns - 2017 - Conflictive preferences towards social investments and transfers in mature welfare states The cases.pdf}
}

